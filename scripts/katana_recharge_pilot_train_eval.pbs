#!/bin/bash
#PBS -N recharge_pilot_train_eval
#PBS -l select=1:ncpus=4:mem=8gb
#PBS -l walltime=04:00:00
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR:?Submit this job from the project root}"
source scripts/katana_recharge_env.sh
: "${CONDITION:?Set CONDITION to RES, BAL, or PROD}"
: "${SEED:?Set SEED to 4100, 4101, or 4102}"
if [[ -n "${RECHARGE_TRAIN_STEPS:-}" ]]; then
  [[ "$RECHARGE_TRAIN_STEPS" =~ ^[1-9][0-9]*$ ]] || { echo "RECHARGE_TRAIN_STEPS must be positive" >&2; exit 1; }
  train_output="outputs/recharge_return_v0.3.0_smoke/${CONDITION}/${SEED}/${RECHARGE_TRAIN_STEPS}"
  eval_output="outputs/recharge_return_v0.3.0_smoke/dev_eval/${CONDITION}/${SEED}/${RECHARGE_TRAIN_STEPS}"
  steps_arg=(--steps "$RECHARGE_TRAIN_STEPS")
else
  train_output="outputs/recharge_return_v0.3.0_pilot/${CONDITION}/${SEED}"
  eval_output="outputs/recharge_return_v0.3.0_pilot/dev_eval/${CONDITION}/${SEED}"
  steps_arg=()
fi
python -m experiments.recharge_return.run train \
  --condition "$CONDITION" --seed "$SEED" \
  --output "$train_output" "${steps_arg[@]}"
checkpoint="$train_output/final.zip"
[[ -s "$checkpoint" ]] || { echo "Training did not produce $checkpoint" >&2; exit 1; }
python -m experiments.recharge_return.run evaluate \
  --condition "$CONDITION" --seed "$SEED" \
  --manifest experiments/recharge_return/grids/development.json \
  --checkpoint "$checkpoint" --output "$eval_output"
