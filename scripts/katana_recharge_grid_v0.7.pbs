#!/bin/bash
#PBS -N recharge_v070_grid
#PBS -l select=1:ncpus=4:mem=8gb
#PBS -l walltime=08:00:00
#PBS -j oe
#PBS -J 1-9
set -euo pipefail
cd "${PBS_O_WORKDIR:?Submit from project root}"
index="${PBS_ARRAY_INDEX:?Nine-task array required}"
[[ "$index" =~ ^[1-9]$ ]] || { echo "Index must be 1..9" >&2; exit 1; }
conditions=(RES BAL PROD)
seeds=(4100 4101 4102)
condition="${conditions[$(((index-1)/3))]}"
seed="${seeds[$(((index-1)%3))]}"
printf 'condition=%s seed=%s steps=600000\n' "$condition" "$seed"
if [[ "${RECHARGE_VALIDATE_MAPPING_ONLY:-0}" == 1 ]]; then exit 0; fi
source scripts/katana_recharge_env.sh
python -m experiments.recharge_return.grid_run --condition "$condition" --seed "$seed"
