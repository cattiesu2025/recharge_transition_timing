#!/bin/bash
#PBS -N recharge_v060_line_mask
#PBS -l select=1:ncpus=4:mem=8gb
#PBS -l walltime=08:00:00
#PBS -j oe
#PBS -J 1-9
set -euo pipefail

cd "${PBS_O_WORKDIR:?Submit this job from the project root}"
index="${PBS_ARRAY_INDEX:?This script must run as a nine-task PBS array}"
[[ "$index" =~ ^[1-9]$ ]] || { echo "PBS_ARRAY_INDEX must be 1..9" >&2; exit 1; }

conditions=(RES BAL PROD)
seeds=(4100 4101 4102)
condition="${conditions[$(((index - 1) / 3))]}"
seed="${seeds[$(((index - 1) % 3))]}"
config="experiments/recharge_return/configs/pilot_line_masked_600k.yaml"
train_output="outputs/recharge_return_v0.6.0_pilot_line_masked_600k/${condition}/${seed}"
eval_output="outputs/recharge_return_v0.6.0_pilot_line_masked_600k/dev_eval/${condition}/${seed}"

printf 'Array task %s: condition=%s seed=%s config=%s\n' "$index" "$condition" "$seed" "$config"
if [[ "${RECHARGE_VALIDATE_MAPPING_ONLY:-0}" == 1 ]]; then
  exit 0
fi

[[ ! -e "$train_output" && ! -e "$eval_output" ]] || {
  echo "Output already exists; inspect it before rerunning: $train_output or $eval_output" >&2
  exit 1
}

source scripts/katana_recharge_env.sh
python -m experiments.recharge_return.run train \
  --config "$config" --condition "$condition" --seed "$seed" \
  --output "$train_output"
checkpoint="$train_output/final.zip"
[[ -s "$checkpoint" ]] || { echo "Training did not produce $checkpoint" >&2; exit 1; }
python -m experiments.recharge_return.run evaluate \
  --config "$config" --condition "$condition" --seed "$seed" \
  --manifest experiments/recharge_return/grids/development.json \
  --checkpoint "$checkpoint" --output "$eval_output"
